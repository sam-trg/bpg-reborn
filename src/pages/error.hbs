<!DOCTYPE html>
<html>
<head>
  <title>Error</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #fff3f3;
      color: #a00;
      padding: 2em;
    }
    .container {
      max-width: 600px;
      margin: auto;
      background: #ffe5e5;
      padding: 2em;
      border-radius: 8px;
      box-shadow: 0 0 8px rgba(0,0,0,0.1);
    }
    h1 {
      margin-top: 0;
    }
    pre {
      background: #fff;
      padding: 1em;
      overflow: auto;
      border: 1px solid #ddd;
      color: #000;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Something went wrong</h1>
    <p>{{message}}</p>
    {{#if error}}
      <pre>{{error}}</pre>
    {{/if}}
  </div>
</body>
</html>
