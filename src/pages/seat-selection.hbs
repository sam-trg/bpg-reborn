<script>
      
        // Mobile menu toggle
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });

        // Seat selection
        const seats = document.querySelectorAll('.seat');
        const selectedSeatDisplay = document.getElementById('selected-seat-display');
        const seatNumberInput = document.getElementById('seat-number');
        const bpSeatNumber = document.getElementById('bp-seat-number');
        let selectedSeat = null;

        seats.forEach(seat => {
            if (!seat.classList.contains('seat-booked')) {
                seat.addEventListener('click', function() {
                    // Deselect previously selected seat
                    if (selectedSeat) {
                        if (selectedSeat.classList.contains('seat-premium')) {
                            selectedSeat.classList.remove('seat-selected');
                            selectedSeat.classList.add('seat-premium');
                        } else {
                            selectedSeat.classList.remove('seat-selected');
                            selectedSeat.classList.add('seat-available');
                        }
                    }
                    
                    // Select new seat
                    selectedSeat = this;
                    this.classList.remove('seat-available', 'seat-premium');
                    this.classList.add('seat-selected');
                    
                    // Update display
                    const seatNumber = this.dataset.seat;
                    selectedSeatDisplay.textContent = seatNumber;
                    seatNumberInput.value = seatNumber;
                    bpSeatNumber.textContent = seatNumber;
                });
            }
        });

        // Generate boarding pass
        document.getElementById('generate-pass').addEventListener('click', function() {
            const passengerName = document.getElementById('passenger-name').value || 'John Doe';
            const flightNumber = document.getElementById('flight-number').value;
            const flightDate = document.getElementById('flight-date').value;
            const boardingTime = document.getElementById('boarding-time').value;
            const gate = document.getElementById('gate').value;
            const to_city = document.getElementById('to_city').value;
            const from_city = document.getElementById('from_city').value;
            
            // Format date
            const date = new Date(flightDate);
            const formattedDate = date.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
            
            // // Update boarding pass
