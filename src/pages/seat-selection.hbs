  <script>


      function updateDisabledOptions(source, target) {
        const selected = source.value;
        Array.from(target.options).forEach(opt => {
          opt.disabled = opt.value === selected;
        });
      }
      
      const fromSelect= document.getElementById('from_city');
      const toSelect = document.getElementById('to_city');
      
      fromSelect.addEventListener('change', () => updateDisabledOptions(fromSelect, toSelect));
      toSelect.addEventListener('change', () => updateDisabledOptions(toSelect, fromSelect));

      // Initialize on load
      updateDisabledOptions(fromSelect, toSelect);


  </script>

                      
