    function updateFields() {
      const key = `${from.value}-${to.value}`;
      const data = routeMap[key];
      if (data) {
        Object.entries(data).forEach(([k, v]) => {
          fields[k].value = v;
          fields[k].readOnly = true;
        });
      } else {
        Object.values(fields).forEach(f => {
          if (f.id !== "seat") {
            f.value = "";
            f.readOnly = false;
          }
        });
      }
    }

    from.addEventListener("change", updateFields);
