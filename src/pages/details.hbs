<form action="/details-submit" method="POST">
  
    <div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 pt-24">
        <h1 class="text-3xl font-bold text-gray-900 mb-8 text-center">Passenger Details</h1>

        <div class="space-y-8">
            <!-- Passenger forms -->
            <div id="passengers-container">
                <div class="passenger-form bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
                    <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 rounded-t-lg">
                        <h2 class="text-lg font-medium flex justify-between items-center">
                            <span>Passenger Details</span>
                            <button type="button" class="remove-passenger text-red-500 hover:text-red-700 hover:bg-red-50 px-2 py-1 rounded hidden">
                                Remove
                            </button>
                        </h2>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="title-1" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                                <select name="title" id="title-1" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500">
                                    <option value="Mr">Mr</option>
                                    <option value="Mrs">Mrs</option>
                                    <option value="Ms">Ms</option>
                                    <option value="Dr">Dr</option>
                                </select>
                            </div>

                            <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label for="firstName-1" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                                    <input name="first_name" id="firstName-1" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="As per government ID">
                                </div>
                                <div>
                                    <label for="lastName-1" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                                    <input name="last_name" id="lastName-1" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="As per government ID">
                                </div>
                            </div>

                            <div>
                                <label for="age-1" class="block text-sm font-medium text-gray-700 mb-1">Age</label>
                                <input id="age-1" type="number" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Age in years">
                            </div>

                            <div>
                                <label for="gender-1" class="block text-sm font-medium text-gray-700 mb-1">Gender</label>
                                <select id="gender-1" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500">
                                    <option value="male">Male</option>
                                    <option value="female">Female</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add passenger button -->
<!--             <button id="add-passenger" class="w-full py-6 border-dashed border-2 border-gray-300 text-gray-500 hover:text-gray-700 hover:border-gray-400 rounded-lg bg-white">
                + Add Another Passenger
            </button> -->

            <!-- Contact Information -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 rounded-t-lg">
                    <h2 class="text-lg font-medium">Contact Information</h2>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                            <input id="email" type="email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Your email address">
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input id="phone" type="tel" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Your phone number">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Options -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 rounded-t-lg">
                    <h2 class="text-lg font-medium">Additional Options</h2>
                </div>
                <div class="p-6">
                    <div class="space-y-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="font-medium">Travel Insurance</h3>
                                <p class="text-sm text-gray-500">Protect your journey for just ₹499 per passenger</p>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="travel-insurance" class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-sky-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-sky-600"></div>
                            </label>
                        </div>

                        <div class="border-t border-gray-200 pt-6">
                            <h3 class="font-medium mb-2">Meal Preference</h3>
                            <select id="meal-preference" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500">
                                <option value="regular">Regular Meal</option>
                                <option value="vegetarian">Vegetarian</option>
                                <option value="vegan">Vegan</option>
                                <option value="kosher">Kosher</option>
                                <option value="halal">Halal</option>
                                <option value="diabetic">Diabetic</option>
                                <option value="gluten-free">Gluten Free</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Proceed button -->
            <div class="sticky bottom-4 bg-white p-4 rounded-lg shadow-lg border border-gray-200">
                <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                    <div>
                        <p class="text-sm text-gray-500">Total Amount</p>
                        <p class="text-2xl font-bold text-gray-900" id="total-amount">₹4,999</p>
                    </div>
                  <button type="submit" class="w-full sm:w-auto bg-sky-600 hover:bg-sky-700 text-white text-lg py-3 px-8 rounded-lg">
                    Select Seat &amp Get Boarding Pass
                  </button>
<!--                     <a href="/seat-selection" class="w-full sm:w-auto bg-sky-600 hover:bg-sky-700 text-white text-lg py-3 px-8 rounded-lg">
                        Select Seat &amp Get Boarding Pass
                    </a> -->
                </div>
            </div>
        </div>
    </div>
</form>
    <script>

        // Add passenger functionality
        const addPassengerBtn = document.getElementById('add-passenger');
        const passengersContainer = document.getElementById('passengers-container');
        let passengerCount = 1;
        const maxPassengers = 5;

        addPassengerBtn.addEventListener('click', function() {
            if (passengerCount < maxPassengers) {
                passengerCount++;
                
                const newPassenger = document.createElement('div');
                newPassenger.className = 'passenger-form bg-white rounded-lg shadow-sm border border-gray-200 mb-6';
                newPassenger.innerHTML = `
                    <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 rounded-t-lg">
                        <h2 class="text-lg font-medium flex justify-between items-center">
                            <span>Passenger ${passengerCount}</span>
                            <button type="button" class="remove-passenger text-red-500 hover:text-red-700 hover:bg-red-50 px-2 py-1 rounded">
                                Remove
                            </button>
                        </h2>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="title-${passengerCount}" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                                <select id="title-${passengerCount}" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500">
                                    <option value="Mr">Mr</option>
                                    <option value="Mrs">Mrs</option>
                                    <option value="Ms">Ms</option>
                                    <option value="Dr">Dr</option>
                                </select>
                            </div>

                            <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label for="firstName-${passengerCount}" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                                    <input id="firstName-${passengerCount}" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="As per government ID">
                                </div>
                                <div>
                                    <label for="lastName-${passengerCount}" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                                    <input id="lastName-${passengerCount}" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="As per government ID">
                                </div>
                            </div>

                            <div>
                                <label for="age-${passengerCount}" class="block text-sm font-medium text-gray-700 mb-1">Age</label>
                                <input id="age-${passengerCount}" type="number" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Age in years">
                            </div>

                            <div>
                                <label for="gender-${passengerCount}" class="block text-sm font-medium text-gray-700 mb-1">Gender</label>
                                <select id="gender-${passengerCount}" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500">
                                    <option value="male">Male</option>
                                    <option value="female">Female</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                    </div>
                `;
                
                passengersContainer.appendChild(newPassenger);
                
                // Show remove button for first passenger if there are multiple passengers
                if (passengerCount === 2) {
                    document.querySelector('.remove-passenger').classList.remove('hidden');
                }
                
                // Hide add button if max reached
                if (passengerCount === maxPassengers) {
                    addPassengerBtn.classList.add('hidden');
                }
                
                // Update total amount
                updateTotalAmount();
            }
        });

        // Remove passenger functionality
        passengersContainer.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-passenger')) {
                e.target.closest('.passenger-form').remove();
                passengerCount--;
                
                // Update passenger numbers
                const passengerForms = document.querySelectorAll('.passenger-form');
                passengerForms.forEach((form, index) => {
                    form.querySelector('h2 span').textContent = `Passenger ${index + 1}`;
                });
                
                // Hide remove button for first passenger if only one passenger
                if (passengerCount === 1) {
                    document.querySelector('.remove-passenger').classList.add('hidden');
                }
                
                // Show add button if below max
                if (passengerCount < maxPassengers) {
                    addPassengerBtn.classList.remove('hidden');
                }
                
                // Update total amount
                updateTotalAmount();
            }
        });

        // Travel insurance toggle
        const travelInsurance = document.getElementById('travel-insurance');
        travelInsurance.addEventListener('change', updateTotalAmount);

        // Update total amount
        function updateTotalAmount() {
            const basePrice = 4999;
            const insurancePrice = 499;
            
            let total = basePrice * passengerCount;
            
            if (travelInsurance.checked) {
                total += insurancePrice * passengerCount;
            }
            
            document.getElementById('total-amount').textContent = `₹${total.toLocaleString()}`;
        }
    </script>
</body>
</html>